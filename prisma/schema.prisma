// Prisma schema. Jira OAuth domain models are introduced in US-02.
// Connection URL comes from prisma.config.ts (NUXT_DATABASE_URL).

generator client {
  provider = "prisma-client"
  output   = "../server/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AuthMethod {
  OAUTH
  API_TOKEN
}

model User {
  id         String      @id @default(cuid())
  accountId  String      @unique
  name       String?
  email      String?
  avatarUrl  String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  workspaces Workspace[]
  drafts     TestCaseDraft[]
  localTests TestCase[]
}

model Workspace {
  id                String          @id @default(cuid())
  ownerId           String
  cloudId           String?
  siteOrigin        String
  siteUrl           String
  name              String
  jiraProjectKey    String?
  jiraProjectId     String?
  jiraProjectName   String?
  projectReadyAt    DateTime?
  testIssueTypeId   String?
  testIssueTypeName String?
  projectStatuses   Json?
  foldersPulledAt   DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  owner             User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  jiraConnection    JiraConnection?
  xrayConnection    XrayConnection?
  projectAccess     WorkspaceProject[]

  @@unique([ownerId, cloudId])
  @@unique([ownerId, siteOrigin])
  @@index([ownerId])
}

enum XrayRegion {
  GLOBAL
  US
  EU
  AU
}

model XrayConnection {
  id           String     @id @default(cuid())
  workspaceId  String     @unique
  region       XrayRegion @default(GLOBAL)
  clientId     String
  clientSecret String
  jwt          String?
  jwtExpiresAt DateTime?
  verifiedAt   DateTime
  configuredAt DateTime   @default(now())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  workspace    Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model JiraConnection {
  id            String     @id @default(cuid())
  workspaceId   String     @unique
  authMethod    AuthMethod @default(OAUTH)
  accessToken   String?
  refreshToken  String?
  expiresAt     DateTime?
  scopes        String[]   @default([])
  apiToken      String?
  apiEmail      String?
  tokenSavedAt  DateTime?
  invalidatedAt DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  workspace     Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model PendingOAuthGrant {
  id              String   @id
  accountId       String
  name            String?
  email           String?
  avatarUrl       String?
  accessToken     String
  refreshToken    String
  accessExpiresAt DateTime
  scopes          String[]
  expiresAt       DateTime
  sites           Json
  createdAt       DateTime @default(now())

  @@index([expiresAt])
}

model ApiTokenSignInAttempt {
  id        String   @id
  ipHash    String
  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
}

enum TestCaseOrigin {
  REMOTE
  IMPORT
}

enum TenantIdentityKind {
  CLOUD_ID
  SITE_ORIGIN
}

model Project {
  id                   String             @id @default(cuid())
  tenantIdentityKind   TenantIdentityKind
  tenantIdentity       String
  jiraProjectId        String
  jiraProjectKey       String
  jiraProjectName      String
  projectReadyAt       DateTime           @default(now())
  testIssueTypeId      String
  testIssueTypeName    String
  projectStatuses      Json
  foldersPulledAt      DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  workspaceAccess      WorkspaceProject[]
  folders              Folder[]
  testCases            TestCase[]

  @@unique([tenantIdentityKind, tenantIdentity, jiraProjectId])
  @@index([jiraProjectKey])
}

model WorkspaceProject {
  id             String    @id @default(cuid())
  workspaceId   String
  projectId     String
  verifiedAt    DateTime  @default(now())
  createdAt     DateTime  @default(now())
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, projectId])
  @@index([projectId])
}

model Folder {
  id               String    @id @default(cuid())
  workspaceId      String?
  jiraProjectId    String?
  projectId        String?
  path             String
  name             String
  parentPath       String?
  remoteTestsCount Int       @default(0)
  pulledAt         DateTime  @default(now())
  project          Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, path])
}

model TestCase {
  id            String            @id @default(cuid())
  projectId     String?
  ownerId       String?
  issueId       String?
  key           String
  summary       String?
  testType      String?
  folderPath    String?
  origin        TestCaseOrigin    @default(REMOTE)
  remoteDeletedAt DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  project       Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner         User?             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  snapshot      TestCaseSnapshot?
  drafts        TestCaseDraft[]

  @@unique([projectId, issueId])
  @@unique([projectId, key])
  @@index([ownerId, key])
}

model TestCaseSnapshot {
  id              String    @id @default(cuid())
  testCaseId      String    @unique
  summary         String
  labels          String[]
  status          String
  gherkin         String?
  remoteUpdatedAt DateTime?
  fingerprint     String
  pulledAt        DateTime  @default(now())
  testCase        TestCase  @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
}

model TestCaseDraft {
  id                     String   @id @default(cuid())
  userId                 String
  testCaseId             String
  summary                String?
  labels                 Json?
  status                 String?
  gherkin                String?
  baseSummary            String?
  baseLabels             String[] @default([])
  baseStatus             String?
  baseGherkin            String?
  baseRemoteUpdatedAt    DateTime?
  baseFingerprint        String?
  baseAvailable          Boolean  @default(true)
  updatedAt              DateTime @updatedAt
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  testCase               TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@unique([userId, testCaseId])
  @@index([testCaseId])
}
