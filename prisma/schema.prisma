// Prisma schema. Jira OAuth domain models are introduced in US-02.
// Connection URL comes from prisma.config.ts (NUXT_DATABASE_URL).

generator client {
  provider = "prisma-client"
  output   = "../server/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AuthMethod {
  OAUTH
  API_TOKEN
}

model User {
  id         String      @id @default(cuid())
  accountId  String      @unique
  name       String?
  email      String?
  avatarUrl  String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  workspaces Workspace[]
}

model Workspace {
  id             String          @id @default(cuid())
  ownerId        String
  cloudId        String?
  siteOrigin     String
  siteUrl        String
  name           String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  owner          User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  jiraConnection JiraConnection?

  @@unique([ownerId, cloudId])
  @@unique([ownerId, siteOrigin])
  @@index([ownerId])
}

model JiraConnection {
  id            String     @id @default(cuid())
  workspaceId   String     @unique
  authMethod    AuthMethod @default(OAUTH)
  accessToken   String?
  refreshToken  String?
  expiresAt     DateTime?
  scopes        String[]   @default([])
  apiToken      String?
  apiEmail      String?
  tokenSavedAt  DateTime?
  invalidatedAt DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  workspace     Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model PendingOAuthGrant {
  id           String   @id
  accountId    String
  name         String?
  email        String?
  avatarUrl    String?
  accessToken  String
  refreshToken String
  accessExpiresAt DateTime
  scopes       String[]
  expiresAt    DateTime
  sites        Json
  createdAt    DateTime @default(now())

  @@index([expiresAt])
}

model ApiTokenSignInAttempt {
  id        String   @id
  ipHash    String
  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
}
