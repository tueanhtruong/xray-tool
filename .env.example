# -----------------------------------------------------------------------------
# xray-tool environment template.
# Copy to .env (`cp .env.example .env`); the defaults work for local development.
# Never put real credentials in this file. Real values live only in .env
# (gitignored) or in CI secrets. See docs/security.md.
# NUXT_* variables map onto Nuxt runtimeConfig (NUXT_DATABASE_URL -> databaseUrl)
# and are validated when the server starts.
# -----------------------------------------------------------------------------

# --- Database (docker-compose.yml; local-only credentials) --------------------
# Development database used by `pnpm dev` and `./scripts/init.sh` migrations. Required.
NUXT_DATABASE_URL=postgresql://xray:xray@localhost:5432/xray_dev
# Test database for `pnpm test:int` / `pnpm test:e2e`. It is RESET on every run,
# so its name must end in `_test` and differ from NUXT_DATABASE_URL.
NUXT_DATABASE_URL_TEST=postgresql://xray:xray@localhost:5432/xray_test

# --- Integration target -------------------------------------------------------
# `live` = real Atlassian/Xray endpoints (use a sandbox site only), `mock` = packages/mock-services.
# Default: live. `pnpm verify` and CI always force `mock`.
NUXT_INTEGRATION_TARGET=live
# Base URL of the mock services (`pnpm mock`). Used when the target is `mock`.
NUXT_MOCK_SERVICES_URL=http://localhost:4010
# Port the mock services listen on; keep it in sync with NUXT_MOCK_SERVICES_URL.
MOCK_SERVICES_PORT=4010

# Optional per-service overrides; when set they win over the target.
# Empty = derived from the target (live: https://auth.atlassian.com,
# https://api.atlassian.com, https://xray.cloud.getxray.app; mock: <mock>/atlassian-auth, ...).
NUXT_ATLASSIAN_AUTH_URL=
NUXT_ATLASSIAN_API_URL=
# e.g. a regional Xray endpoint such as https://eu.xray.cloud.getxray.app
NUXT_XRAY_BASE_URL=

# --- Atlassian OAuth 2.0 (3LO) app — needed from US-02 --------------------------
# Create at https://developer.atlassian.com/console/myapps/
NUXT_ATLASSIAN_CLIENT_ID=
NUXT_ATLASSIAN_CLIENT_SECRET=
NUXT_ATLASSIAN_REDIRECT_URI=http://localhost:3000/auth/jira/callback

# --- Secret encryption — needed from US-01 --------------------------------------
# 32 random bytes, base64. Generate: openssl rand -base64 32
NUXT_ENCRYPTION_KEY=

# --- Sandbox credentials for `pnpm test:live` (from US-02/US-04) --------------
# Used only by live contract tests against a DEDICATED sandbox site/project.
# In the app itself users enter these through the UI and they are stored encrypted.
SANDBOX_JIRA_SITE_URL=https://your-sandbox.atlassian.net
SANDBOX_JIRA_EMAIL=
# Jira API token fallback (US-03): https://id.atlassian.com/manage-profile/security/api-tokens
SANDBOX_JIRA_API_TOKEN=
# Xray Cloud API key (US-04): Xray > Settings > API Keys
SANDBOX_XRAY_CLIENT_ID=
SANDBOX_XRAY_CLIENT_SECRET=
# Jira project key used for live tests; automated writes stay inside it.
SANDBOX_PROJECT_KEY=
